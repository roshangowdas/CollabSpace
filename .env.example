# ==============================================================================
# CollabSpace Environment Configuration Template
# CRITICAL: Never commit your real .env file or private service_role keys to Git.
# ==============================================================================

# Supabase Public Configuration (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Application Environment Settings
VITE_APP_NAME=CollabSpace
VITE_APP_ENV=development

# Controlled Debug Mode (false in production to prevent information leakage)
VITE_DEBUG_MODE=false

# Workspace Super Administrator Email
VITE_SUPER_ADMIN_EMAIL=0243roshan@gmail.com

